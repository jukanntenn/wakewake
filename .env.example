# WakeWake 环境变量（configuration.md §6 + deployment/topology.md §9）。
# 环境变量分层：WAKEWAKE_ 前缀，__ 嵌套分隔（config-rs，§0.5 验证）。
# chmod 600 .env，不入 git。

# ============================================================
# App（应用对外公网地址）
# ============================================================
# [REQUIRED] 应用对外公网地址（含 scheme+host[+port]）
# 用于邮件验证/重置链接。必须与实际对外访问地址一致。
WAKEWAKE_APP__PUBLIC_URL=https://wakewake.app

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_DB=wakewake
POSTGRES_USER=wakewake
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ============================================================
# JWT（[REQUIRED] 生成命令：openssl rand -base64 32，≥32 字节）
# ============================================================
# [REQUIRED] Access token HMAC 签名密钥
WAKEWAKE_JWT__SIGNING_KEY=CHANGE_ME_openssl_rand_base64_32
# [REQUIRED] Refresh token HMAC 签名密钥（与 access 独立）
WAKEWAKE_JWT__REFRESH_SIGNING_KEY=CHANGE_ME_openssl_rand_base64_32
# [OPTIONAL] Access TTL（默认 15m）
# WAKEWAKE_JWT__ACCESS_EXPIRE=15m
# [OPTIONAL] Refresh TTL（默认 720h = 30d）
# WAKEWAKE_JWT__REFRESH_EXPIRE=720h

# ============================================================
# 密码重置（[REQUIRED] HMAC 密钥，openssl rand -base64 32）
# ============================================================
WAKEWAKE_PASSWORD_RESET__SECRET=CHANGE_ME_openssl_rand_base64_32
# [OPTIONAL] reset token TTL（默认 1h）
# WAKEWAKE_PASSWORD_RESET__EXPIRE=1h

# ============================================================
# PoW（防滥用，authentication.md §六）
# ============================================================
# [OPTIONAL] 前导零个数（默认 4）
# WAKEWAKE_POW__DIFFICULTY=4
# [OPTIONAL] challenge 有效期（默认 10m）
# WAKEWAKE_POW__CHALLENGE_TTL=10m

# ============================================================
# 邮件（密码重置，mailer.enabled=false 时该端点返 503）
# ============================================================
MAILER_ENABLED=false
# WAKEWAKE_MAILER__SMTP_HOST=smtp.example.com
# WAKEWAKE_MAILER__SMTP_PORT=587
# WAKEWAKE_MAILER__SMTP_USERNAME=
# WAKEWAKE_MAILER__SMTP_PASSWORD=
# WAKEWAKE_MAILER__FROM_ADDRESS=noreply@wakewake.app

# ============================================================
# Security（默认 admin 账户 bootstrap）
# ============================================================
# 启动时幂等创建（不存在才建）。生产务必改默认值！
# WAKEWAKE_SECURITY__BOOTSTRAP_ADMIN_EMAIL=admin@wakewake.local
# WAKEWAKE_SECURITY__BOOTSTRAP_ADMIN_PASSWORD=wakewake123

# ============================================================
# 日志（tracing-appender 文件轮转 + OTel）
# ============================================================
RUST_LOG=info
# 日志目录（daily rolling，4 文件 app/traces/metrics/logs）
# WAKEWAKE_LOG__DIR=data/logs
# OTel 远程导出（设了走 OTLP collector；不设走本地文件 exporter）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ============================================================
# ACME（Caddy TLS 证书）
# ============================================================
ACME_EMAIL=admin@wakewake.app

# ============================================================
# 前端开发
# ============================================================
FRONTEND_PORT=3034
API_PROXY_TARGET=http://localhost:8080

# ============================================================
# Agent（wakewake-agent 用，server 不读取这些变量）
# agent 的配置文件/环境变量是独立的——仅 agent 二进制读取 WAKEWAKE_ 前缀。
# 详见 backend/crates/agent/config.example.toml 和 README.md
# ============================================================
# [REQUIRED] agent 连接的 server URL
# WAKEWAKE_SERVER_URL=https://wakewake.app
# [REQUIRED] pairing code（16 位十六进制，从 agents 页获取）
# WAKEWAKE_PAIRING_CODE=CHANGE_ME_a1b2c3d4e5f60718
# [OPTIONAL] agent home 目录（存 config.toml + key.pem，默认 ~/.wakewake）
# WAKEWAKE_HOME=/home/user/.wakewake
