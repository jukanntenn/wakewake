{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: All",
      "detail": "devops/dev.py start — infra (postgres+mailpit) + backend (cargo watch) + frontend (pnpm dev)",
      "type": "shell",
      "command": "python3",
      "args": ["devops/dev.py", "start"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": [],
      "isBackground": true,
      "icon": { "id": "rocket", "color": "terminal.ansiBlue" }
    },
    {
      "label": "Dev: Stop",
      "detail": "devops/dev.py stop",
      "type": "shell",
      "command": "python3",
      "args": ["devops/dev.py", "stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "focus": false,
        "close": true
      },
      "problemMatcher": [],
      "icon": { "id": "stop", "color": "terminal.ansiRed" }
    },
    {
      "label": "Dev: Backend",
      "detail": "cargo watch + run with backend/config.local.toml (infra auto-started, self-contained)",
      "type": "shell",
      "command": "python3 ../devops/dev.py init && cargo watch -x 'run -- --config config.local.toml serve'",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": [],
      "isBackground": true,
      "icon": { "id": "server", "color": "terminal.ansiGreen" }
    },
    {
      "label": "Dev: Frontend",
      "detail": "pnpm dev (port ${FRONTEND_PORT:-3034}, /api proxied to localhost:8080)",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "problemMatcher": [],
      "isBackground": true,
      "icon": { "id": "globe", "color": "terminal.ansiYellow" }
    }
  ]
}
