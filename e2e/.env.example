# E2E 测试环境变量（e2e.md §3.2 .env.example）。
# 复制为 .env 并按需修改（.env 不入 git）。

# 被测服务 base URL（默认本地 docker compose 映射的 8443）
BASE_URL=https://localhost:8443

# globalSetup 注册的测试用户（e2e.md §5.1）
E2E_USER_EMAIL=e2e@wakewake.local
E2E_USER_PASSWORD=TestPass123!

# PostgreSQL 直查（e2e.md §4.5 utils/db.ts 用）
POSTGRES_USER=wakewake
POSTGRES_PASSWORD=test
POSTGRES_DB=wakewake_test
