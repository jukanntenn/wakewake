# {{ ansible_managed }}
# 备份脚本的凭据载体（pg-dump-backup / backup-check / backup-drill 经
# systemd 用户单元的 EnvironmentFile 读取）。0600——含 vault 加密的
# 对象存储密钥对。与 config.toml.j2 的可选旋钮同守卫：vault 变量未定义时
# 渲染任务整体跳过，部署保持绿色（setup-order 契约：先建桶、发 key、
# vault 写入，再跑 playbook 激活，见 devops/backup.md）。
{% if b2_key_id is defined %}
B2_S3_ENDPOINT="{{ b2_s3_endpoint }}"
B2_S3_REGION="{{ b2_s3_region }}"
B2_BUCKET="{{ b2_bucket }}"
B2_ACCESS_KEY_ID="{{ b2_key_id }}"
B2_SECRET_ACCESS_KEY="{{ b2_secret_access_key }}"
{% if kuma_backup_url is defined %}
# push URL 含 & 字符：引号是 load-bearing 的（backup-check.py 的 load_env
# 会剥掉一层引号；shell source 本文件时也需要它们）。
KUMA_BACKUP_URL="{{ kuma_backup_url }}"
{% endif %}
{% endif %}
