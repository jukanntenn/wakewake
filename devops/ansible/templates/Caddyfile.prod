# {{ ansible_managed }}
# wakewake Caddyfile（prod）。路由唯一真源在镜像内 /app/caddy/routes.caddy
# （import），本文件只声明站点地址、TLS 层与 Cloudflare 接入层。
#
# 拓扑：访客 -> Cloudflare（免费 CDN）-> 直连回源本容器 Caddy。
# TLS：Cloudflare Origin Certificate（CF dashboard 生成）挂载进容器，
# Caddy 用它服务 HTTPS（CF 回源模式 Full-strict）。
#
# CF 接入层（cloudflare-edge WRFC，两件必须同进同退）：
#   1. remote_ip 守卫：仅放行 CF CIDR 回源，其余直连 403——绕过 CF 即绕过
#      全部边缘防护（限速/WAF/缓存），必须拒绝。CIDR 真源 cloudflare.com/ips，
#      在 group_vars/prod/env.yml 的 cloudflare_cidrs 维护（季度核对）。
#   2. trusted_proxies + client_ip_headers：访问日志 client_ip 取 CF-Connecting-IP
#      （真实访客）而非 CF 边缘节点 IP。
#   ⚠️ trusted_proxies 使 reverse_proxy 对上游改为"保留 XFF 并追加对端"
#   （链形如 `伪造值, 真实访客, CF边缘`，最左可伪造）——后端必须配
#   [server].client_ip_header = "CF-Connecting-IP"（config.toml.j2 已接线），
#   否则限流 key / 登录审计 IP 可被伪造。移除任一侧前先读 WRFC。
#   VPS 防火墙仅放行 CF CIDR 是第二层（devops/cloudflare.md §6），可选加固。
{
	# Origin Cert 已显式提供，禁用 ACME 自动签发。
	auto_https off

	servers {
		# 访问日志 client_ip = CF-Connecting-IP（真实访客 IP）。
		trusted_proxies static {{ cloudflare_cidrs }}
		client_ip_headers CF-Connecting-IP
	}
}

import /app/caddy/routes.caddy

https://:{{ caddy_port }} {
	# CF Origin Cert（group_vars/prod/env.yml 的 origin_cert/origin_key）。
	tls {{ origin_cert | default("/app/certs/origin.pem") }} {{ origin_key | default("/app/certs/origin.key") }}

	# 仅放行 Cloudflare 回源（CIDR 真源 cloudflare.com/ips），其余直连一律 403。
	@not_cf not remote_ip {{ cloudflare_cidrs }}
	respond @not_cf 403

	import wakewake_routes
}
