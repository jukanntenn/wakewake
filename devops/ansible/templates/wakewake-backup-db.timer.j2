# {{ ansible_managed }}
# 每日逻辑备份（pg_dump -> zstd -> 对象存储）。03:30 避开 04:45/05:30 的
# 后续作业；Persistent 补跑停机期间错过的触发。
[Unit]
Description=Daily wakewake pg_dump to object storage

[Timer]
# 指回模板服务实例（%i = 脚本文件名）；缺了这行 timer 会去找同名的
# wakewake-backup-db.service（不存在）而启动失败。
Unit=wakewake-backup@pg-dump-backup.py.service
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
