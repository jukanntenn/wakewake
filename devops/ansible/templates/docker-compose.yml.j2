# {{ ansible_managed }}
# wakewake docker-compose（为 {{ env }} 渲染）。
#
# 拓扑在所有环境一致：wakewake 容器（Caddy + Rust backend via s6-overlay）
# 加一个通过共享 Unix-socket 卷连接的兄弟 postgres。每环境的差异仅限于
# 对外 host 端口。app data 目录（日志）每环境都绑定挂载。
#
# Postgres 永不对外发布——仅通过共享 postgres-socket 卷从 app 容器可达。

services:
  wakewake:
    image: {{ image }}
    container_name: {{ app_name }}
    ports:
{% if loopback_publish | default(false) %}
      # 宿主网关型环境（prod）：仅回环发布，对外唯一入口是宿主 Caddy :443。
      - "127.0.0.1:{{ host_port }}:{{ caddy_port }}"
{% else %}
      - "{{ host_port }}:{{ caddy_port }}"
{% endif %}
    volumes:
      - {{ config_file }}:/app/config.toml:ro
      - {{ app_path }}/data:/app/data
{% if caddyfile_template is defined %}
      # s6 caddy run 脚本硬编码读 /app/Caddyfile（docker/s6/s6-rc.d/caddy/run），
      # 挂载点必须与之一致，否则 Caddy 起不来。未定义模板的环境（staging/prod）
      # 不挂载，直接用镜像内置 plain HTTP Caddyfile（TLS 由外部终结）。
      - {{ caddyfile }}:/app/Caddyfile:ro
{% endif %}
      - postgres-socket:/var/run/postgresql
{% if tls_profile == 'https' %}
      # Caddy 内部 CA 存储持久化（s6 caddy run 设 HOME=/root，故 CA 在
      # /root/.local/share/caddy）。否则容器重建 -> CA 重新生成 -> 已信任的
      # agent/浏览器全部失效。仅 tls internal（dev）需要；HTTP 环境无内部 CA。
      - caddy-data:/root/.local/share/caddy
{% endif %}
{% if otel_otlp_endpoint is defined and otel_otlp_token is defined and otel_otlp_endpoint.startswith('http://host.docker.internal') %}
    # OTLP 端点指向宿主回环（frp 隧道口）时，容器内 127.0.0.1 是容器自身——
    # 经 host-gateway（docker0 网关 IP）打宿主监听的端口。
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% endif %}
    environment:
      # 应用配置唯一载体是挂载的 config.toml（DSN/密钥均渲染在内，password 已 urlencode）。
      # 这里只留容器级环境；WAKEWAKE_* env 会覆盖 TOML，勿双写同一值。
      - TZ={{ tz | default("UTC") }}
{% if otel_otlp_endpoint is defined and otel_otlp_token is defined %}
      # OTLP 遥测（devops/monitoring.md）：端点+token 都在（token 走 vault）才
      # 渲染——未定义时容器零 env 改动，后端退回本地 JSONL 文件模式兜底。
      # tonic 导出器从 OTEL_EXPORTER_OTLP_HEADERS 读 bearer 头（值 URL-decode，
      # 故空格写 %20）；deployment.environment.name 经 SDK 的 EnvResourceDetector
      # 并入 resource，Grafana 面板/告警按它分环境切片。
      - OTEL_EXPORTER_OTLP_ENDPOINT={{ otel_otlp_endpoint }}
      - OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20{{ otel_otlp_token }}
      - OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name={{ env }}
{% endif %}
    depends_on:
      postgres:
        condition: service_healthy
    # SSE 长连接按连接数吃 FD：默认 soft nofile（常见 1024）约 1000 连接即触顶。
    # 显式抬到 1M（与 tests/load 压测 override 同口径），与镜像内 s6 后端共享。
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    healthcheck:
      # tls_profile=https: Caddy 终结 TLS（tls internal 自签），用 https + -k 跳过证书校验。
      # tls_profile=http: 外部反代终结 TLS，容器内 Caddy 是 plain HTTP。
{% if tls_profile == 'https' %}
      test: ["CMD", "curl", "-fk", "https://127.0.0.1:{{ caddy_port }}/api/v1/health"]
{% else %}
      test: ["CMD", "curl", "-f", "http://127.0.0.1:{{ caddy_port }}/api/v1/health"]
{% endif %}
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: always

  postgres:
    image: postgres:17-alpine
    container_name: {{ app_name }}-postgres
    environment:
      - POSTGRES_DB={{ postgres_db }}
      - POSTGRES_USER={{ postgres_user }}
      - POSTGRES_PASSWORD={{ db_password }}
    # 5 个调优 GUC 叠加在镜像默认 postgresql.conf 之上。socket 目录保持镜像默认
    # /var/run/postgresql（entrypoint 拥有权限）；app 通过共享卷连接。
    command:
      - postgres
      - -c
      - shared_buffers=256MB
      - -c
      - max_connections=50
      - -c
      - effective_cache_size=1GB
      - -c
      - maintenance_work_mem=128MB
      - -c
      - synchronous_commit=off
    volumes:
      - pgdata:/var/lib/postgresql/data
      - postgres-socket:/var/run/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h /var/run/postgresql -U {{ postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    restart: always

volumes:
  pgdata:
  postgres-socket:
{% if tls_profile == 'https' %}
  caddy-data:
{% endif %}
