# 本地验收 Caddy 配置（自签名 TLS），e2e（docker-compose.e2e.yml）也挂载本文件：
# agent（宿主机）与 Playwright 都通过 localhost:8443 访问。
# 挂载到 /app/Caddyfile；路由唯一真源在镜像内 /app/caddy/routes.caddy（import）。
#
# 同步矩阵（仅剩两条）：
#   SAN localhost, app：app = docker-compose.local.yml 服务名（docker DNS），改名必须同步。
#   tls internal：浏览器/agent 需信任 Caddy 内部 CA（agent 带 danger-insecure-tls feature）。

{
	local_certs
	# Caddy 默认把 TLS 证书维护/自动 HTTPS 等日志打到 INFO，会淹没 backend 业务日志。
	# 降到 WARN：只保留警告/错误，让 docker logs 突显 wakewake-server 的可观测日志。
	log {
		level WARN
	}
}

import /app/caddy/routes.caddy

localhost:8443, app:8443 {
	tls internal
	import wakewake_routes
}
