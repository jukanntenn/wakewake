# Wakewake environment variables (postgres credentials only).
#
# App configuration (JWT keys, public_url, mailer) lives in config.toml —
# copy config.example.toml alongside this file. This .env holds only what the
# postgres container image needs; the app DSN is assembled from these vars in
# docker-compose.yml, so the password is written exactly once.
#
#   1. cp config.example.toml config.toml && cp .env.example .env
#   2. edit secrets in config.toml + the password below
#   3. docker compose up -d

# ── PostgreSQL ──
POSTGRES_DB=wakewake
POSTGRES_USER=wakewake
POSTGRES_PASSWORD=change-me

# ── Optional ──
# Timezone for the container (TZ is read by s6 cont-init.d/01-setup.sh).
# TZ=UTC
