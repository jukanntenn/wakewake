# Wakewake Environment Variables
# Copy this file to .env and edit as needed.
#
# Usage:
#   1. cp .env.example .env
#   2. edit secrets (JWT keys, POSTGRES_PASSWORD)
#   3. docker compose up -d
#   4. open http://<your-ip>:8443
#
# All WAKEWAKE_* vars use the config-rs env override (prefix WAKEWAKE_,
# nested separator __). See backend/config.example.toml for the full schema.

# ── JWT (change these to random 32-byte strings!) ──
# Generate: openssl rand -base64 32
WAKEWAKE_JWT__SIGNING_KEY=change-me-min-32-bytes-padding!!
WAKEWAKE_JWT__REFRESH_SIGNING_KEY=change-me-min-32-bytes-padding!!

# ── Password Reset (stateless reset token HMAC secret) ──
WAKEWAKE_PASSWORD_RESET__SECRET=change-me-min-32-bytes-padding!!

# ── PostgreSQL (POSTGRES_PASSWORD is shared with the postgres service) ──
# The app connects over the shared postgres-socket Unix-socket volume;
# the DSN is assembled in docker-compose.yml from these vars.
POSTGRES_DB=wakewake
POSTGRES_USER=wakewake
POSTGRES_PASSWORD=change-me

# ── Optional ──
# Timezone for the container (TZ is read by s6 cont-init.d/01-setup.sh).
# TZ=UTC

# Mailer (password reset emails; disabled by default → reset endpoint returns 503).
# WAKEWAKE_MAILER__ENABLED=false
# WAKEWAKE_MAILER__SMTP_HOST=smtp.example.com
# WAKEWAKE_MAILER__SMTP_PORT=587
# WAKEWAKE_MAILER__SMTP_USERNAME=
# WAKEWAKE_MAILER__SMTP_PASSWORD=
# WAKEWAKE_MAILER__FROM_ADDRESS=noreply@wakewake.app
# WAKEWAKE_MAILER__FROM_NAME=WakeWake

# Bypass axum-governor rate limiting (keep false in production; e2e/load test only).
# WAKEWAKE_RATE_LIMIT__DISABLED=false
